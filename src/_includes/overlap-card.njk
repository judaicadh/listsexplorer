{% macro overlapCard(group) %}
<details class="panel overlap-card" id="{{ group.id }}">
  <summary><strong>{{ group.name }}</strong> <span class="chip">{{ group.score }}% match confidence</span> <span>{{ group.listCount }} lists · {% if group.linked %}Existing person record{% else %}Full-name candidate{% endif %}</span></summary>
  <div class="stack">
    {% if group.personUrl %}<p><a href="{{ group.personUrl }}">Open person record →</a></p>{% endif %}
    {% for row in group.rows %}
    <section class="overlap-evidence stack">
      <h3>{{ row.name }} <span class="chip">{% if row.reference %}Reference record{% else %}{{ row.score }}% match confidence{% endif %}</span></h3>
      <p><a href="{{ row.list.url }}">{{ row.list.title }}</a> · {{ row.list.date }}{% if row.place %} · {{ row.place }}{% endif %}{% if row.amount %} · {{ row.amount }}{% endif %}</p>
      <ul>{% for reason in row.reasons %}<li>{{ reason }}</li>{% endfor %}</ul>
    </section>
    {% endfor %}
  </div>
</details>
{% endmacro %}
