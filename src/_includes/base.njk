<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} — {% endif %}{{ site.title }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Inter:wght@400;500;600&family=Frank+Ruhl+Libre:wght@500&display=swap">
<link rel="stylesheet" href="/assets/style.css">
<script>window.SITE_BASE = {{ site.pathPrefix | json | safe }};</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href="/">
      <span class="brand-name">{{ site.title }}</span>
      <span class="brand-tag">{{ site.tagline }}</span>
      <span class="brand-tag brand-by">by {{ site.creator }}</span>
    </a>
    <nav aria-label="Main" class="main-nav">
      {%- set nav = [["/search/","Search"],["/lists/","Lists"],["/sources/","Sources"],["/people/","People"],["/organizations/","Organizations"],["/places/","Places"],["/map/","Map"],["/agents/","Agents"],["/contribute/","Add a list"],["/about/","About"]] -%}
      {%- for item in nav %}
      <a href="{{ item[0] }}"{% if page.url.startsWith(item[0]) %} aria-current="page"{% endif %}>{{ item[1] }}</a>
      {%- endfor %}
    </nav>
  </div>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="site-footer">
  <div class="wrap footer-row">
    <span>Conceived and created by {{ site.creator }} with the help of AI · <a href="https://creativecommons.org/licenses/by/4.0/">{{ site.license }}</a></span>
    <span class="footer-links"><a href="/about/">About</a><a href="/data/">Download data</a>{% if site.repoUrl %}<a href="{{ site.repoUrl }}">GitHub</a>{% endif %}</span>
  </div>
</footer>
</body>
</html>
